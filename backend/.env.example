# ─────────────────────────────────────────────
#   Distributed File Storage — Environment Config
#   Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# AWS Region (e.g. us-east-1, ap-south-1)
AWS_REGION=us-east-1

# IAM Programmatic Access Credentials
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# S3 Bucket Name (must already exist in AWS Console)
S3_BUCKET_NAME=my-distributed-storage-bucket

# DynamoDB Table Name
DYNAMO_TABLE_NAME=FileMetadata

# Server Port (run a second instance on 3002 for load balancing)
PORT=3001

# Max upload size in MB (must match nginx client_max_body_size)
MAX_UPLOAD_MB=50
